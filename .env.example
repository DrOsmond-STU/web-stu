# ----------------------------------------------------------------------------
# CV. SEMESTA TEKNOLOGI UTAMA - Konfigurasi Environment
# Salin file ini menjadi .env  ->  cp .env.example .env
# ----------------------------------------------------------------------------

# URL publik website (tanpa slash di akhir). Dipakai untuk sitemap, canonical & Open Graph.
NEXT_PUBLIC_SITE_URL=https://semestateknologiutama.com

# --- Database PostgreSQL (wajib) --------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Di cPanel biasanya: postgres://cpaneluser_stu:password@localhost:5432/cpaneluser_websitedb
DATABASE_URL=postgres://user:password@localhost:5432/semesta_db

# Set "true" bila server Postgres mewajibkan SSL (Neon, Supabase, Railway, dsb).
DATABASE_SSL=false

# --- Keamanan sesi admin (wajib) --------------------------------------------
# Buat string acak minimal 32 karakter:  openssl rand -base64 48
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter-yang-sangat-rahasia

# Akun admin pertama yang dibuat oleh perintah `npm run db:seed`
ADMIN_EMAIL=admin@semestateknologiutama.com
ADMIN_PASSWORD=StuAdmin#2025
ADMIN_NAME=Administrator

# --- Integrasi GitHub (opsional) --------------------------------------------
# Dipakai tombol "Sinkronkan dari GitHub" di CMS untuk menarik daftar repositori.
# Buat Personal Access Token (classic) dengan scope `repo` bila ingin repo privat ikut tampil.
GITHUB_USERNAME=DrOsmond-STU
GITHUB_TOKEN=

# --- Upload berkas ----------------------------------------------------------
# Folder tujuan upload gambar dari CMS (relatif terhadap root project).
UPLOAD_DIR=public/uploads
